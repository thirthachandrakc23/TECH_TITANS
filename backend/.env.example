# DigitalVision Backend — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit real credentials to source control. .env is in .gitignore.

# Google Gemini API key (obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyD9w26Fi4lhONhes32-BNilmG6GVlI2OjE

# Gemini Multimodal Model Identifier
# Default: gemini-2.5-flash (or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend server port (default: 3001)
PORT=3001

# Request timeout in milliseconds (default: 15000 = 15s)
REQUEST_TIMEOUT_MS=15000
